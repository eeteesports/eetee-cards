# eetee-cards-site — environment template
#
# Copy this file to `.env.local` (same directory) and fill in real values.
# `.env.local` is git-ignored and must never be committed. In PRODUCTION
# (Vercel), the same variable names must instead be set in the Vercel
# project's dashboard (Settings -> Environment Variables) — a local
# `.env.local` change alone never touches the live site. See HANDOFF.md
# (in the parent "eetee Card Collection" folder) for full context.

# ── Database (Turso / libSQL) — REQUIRED ────────────────────────────────
# Shared with eetee-cards-app — both apps read/write the SAME database.
TURSO_DATABASE_URL=libsql://<database-name>.turso.io
TURSO_AUTH_TOKEN=<turso-auth-token>

# ── AI (Anthropic) — used by /api/identify, /api/parse-voice, etc. ──────
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Cloudinary (card photo hosting, read-only from the site's side) ─────
# Client components display images uploaded by eetee-cards-app.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ── Stripe (checkout) — REQUIRED for real orders ────────────────────────
# LIVE keys today, not test-mode — real money moves through this. Get
# these from the Stripe dashboard (dashboard.stripe.com/apikeys).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
# From the Stripe dashboard's Webhooks section, for the endpoint at
# /api/webhooks/stripe (order-confirmation + card-sold-status updates).
STRIPE_WEBHOOK_SECRET=whsec_...

# ── eBay (OAuth connect/callback + Sell API) ────────────────────────────
# This site OWNS the eBay OAuth connect/callback routes; eetee-cards-app
# just reads the token pair this stores in Turso. Same eBay application/
# keyset as eetee-cards-app's EBAY_APP_ID/EBAY_CERT_ID.
EBAY_APP_ID=
EBAY_DEV_ID=
EBAY_CERT_ID=
EBAY_RUNAME=

# ── Resend (transactional email) ────────────────────────────────────────
# New-order notifications to Evan + buyer emails.
RESEND_API_KEY=

# ── Auth (next-auth) — gates /dashboard, /collection, /add, /bulk-add, ──
# /admin, /scout, /tools (see middleware.js)
NEXTAUTH_SECRET=
# Recommended in production even though not directly read by app code —
# next-auth itself uses it. Vercel usually infers this automatically from
# the deployment URL, but set explicitly if login redirects misbehave.
# NEXTAUTH_URL=https://www.eetee.cards
ADMIN_PASSWORD=

# ── Analytics ────────────────────────────────────────────────────────────
# GA4 measurement ID is hardcoded in app/layout.js (G-Z6WJXPD14L), not an
# env var — nothing to set here. Vercel Web Analytics (@vercel/analytics)
# is zero-config on Vercel. Listed for completeness only.
